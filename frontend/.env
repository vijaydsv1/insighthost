# Backend origin the frontend talks to (chat, camera, video, WebSocket).
# Change this to the real host:port where the backend runs in your
# deployment (e.g. http://192.168.1.50:8002 for a kiosk PC on the
# same network, or a domain if reverse-proxied). This is a build-time
# value (Create React App convention) - run `npm run build` again
# after changing it.
REACT_APP_BACKEND_ORIGIN=http://localhost:8002
